{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:suppliers": "tsx watch src/suppliers/server.ts",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/temporal/worker.ts",
    "dev:stack": "tsx src/scripts/dev-stack.ts",
    "start:suppliers": "node dist/suppliers/server.js",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/temporal/worker.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern=unit",
    "test:workflow": "jest --runInBand --testPathPattern=workflow"
  },
  "dependencies": {
    "@temporalio/activity": "^1.11.0",
    "@temporalio/client": "^1.11.0",
    "@temporalio/common": "^1.11.0",
    "@temporalio/worker": "^1.11.0",
    "@temporalio/workflow": "^1.11.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "nanoid": "^3.3.7"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.11.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
